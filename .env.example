# Used by Docker Compose. For native development, export these variables before
# running scripts/serve.py (the Python server does not load .env automatically).
# Leave the domain empty for local development. On Jelastic: snackpress.io
# Hostname only: no scheme, path or port. Used by Caddy for canonical redirects.
SNACKPRESS_DOMAIN=
# Optional override. Leave empty to derive the URL automatically:
# local Compose -> http://127.0.0.1:8080
# production Compose -> https://SNACKPRESS_DOMAIN (or the Jelastic URL if unset)
# Native/Vite development -> export http://127.0.0.1:5173 when needed.
SNACKPRESS_PUBLIC_URL=

# smtp (default) or file (local development only; private .data/mail-outbox/*.eml).
SNACKPRESS_MAIL_MODE=smtp
SNACKPRESS_MAIL_FROM=
SNACKPRESS_SMTP_HOST=
SNACKPRESS_SMTP_PORT=587
SNACKPRESS_SMTP_SECURITY=starttls
SNACKPRESS_SMTP_USERNAME=
SNACKPRESS_SMTP_PASSWORD=
# Production SMTP servers must support STARTTLS (587) or implicit TLS (465).
