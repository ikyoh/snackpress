FROM python:3.12-slim-bookworm AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

FROM python:3.12-slim-bookworm AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home snackpress \
    && mkdir /data && chown snackpress /data
WORKDIR /app
COPY --from=dependencies /app/.venv /app/.venv
COPY apps/api apps/api
COPY packages/imposition packages/imposition
COPY packages/prepress packages/prepress
COPY alembic.ini ./
COPY infra/migrations infra/migrations
USER snackpress
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/apps/api:/app/packages/imposition:/app/packages/prepress \
    SNACKPRESS_DATA=/data \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1
EXPOSE 8000
CMD ["uvicorn", "snackpress_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
